# ===========================================================================
# The one file you edit.
#
#   cp mail.env.example mail.env && $EDITOR mail.env && sudo ./install-mail.sh
#
# install-mail.sh reads it, renders every template from it, and installs a
# resolved copy at /etc/vitaqueen-mail.env for bin/* to read afterwards.
# Nothing here is a secret except CF_API_TOKEN_FILE's contents; mail.env itself
# is gitignored regardless.
# ===========================================================================

# --- Identity --------------------------------------------------------------
# The domain that appears after the @. Any domain — this directory has nothing
# in it that assumes vitaqueen.com.
MAIL_DOMAIN=example.com

# The name of this machine. Must be a subdomain you control, must have an A
# record pointing here, and the IP's PTR record must point back to it. That
# three-way agreement is the first thing every receiving server checks.
MAIL_HOSTNAME=mail.example.com

# Envelope domain for application mail, so its bounces and its reputation are
# separable from the humans'. Becomes bounce.example.com.
BOUNCE_SUBDOMAIN=bounce

# --- First mailbox ---------------------------------------------------------
# Created on the first run, with a generated password printed once. Everything
# after this is `mailbox add`.
PRIMARY_USER=you

# Default mailbox size. Per-mailbox overrides: `mailbox quota you@example.com 20G`.
QUOTA=5G

# --- What to build ---------------------------------------------------------
# The application plane: an app@ submission account, the bounce domain, a
# second DKIM key. Set to `no` for a purely personal mail server.
APP_PLANE=yes

# Roundcube on webmail.<domain>. Worth having even with a desktop client: it is
# the path that keeps working from a network that dislikes IMAP.
WEBMAIL=yes

# `ipv4` until the provider gives you working IPv6 reverse DNS. Gmail is
# stricter over IPv6 than IPv4 and rejects mail from an address with no
# matching PTR — an AAAA record published too early costs you delivery.
INET_PROTOCOLS=ipv4

# Networks that must never be locked out by fail2ban. Space-separated CIDRs;
# the office, the VPN, your own address. Leave empty if you are not sure.
TRUSTED_CIDRS=

# --- Certificates ----------------------------------------------------------
LETSENCRYPT_EMAIL=postmaster@example.com

# standalone       binds port 80 for a moment during issue and renewal
# dns-cloudflare   DNS-01 via the Cloudflare API; port 80 stays shut
CERTBOT_MODE=standalone

# Only for dns-cloudflare. A file containing:
#   dns_cloudflare_api_token = <token with Zone:DNS:Edit on this zone only>
CF_API_TOKEN_FILE=/root/.cloudflare.ini

# --- Sizes -----------------------------------------------------------------
# 50 MB accepted ≈ a 35 MB attachment after encoding.
MESSAGE_SIZE_LIMIT=52428800
DKIM_KEY_BITS=2048

# Role addresses to create as aliases onto PRIMARY_USER. Space-separated local
# parts; postmaster, abuse, dmarc, tlsrpt and noreply are always created because
# the internet expects them. For the VitaQueen API these are the five that
# apps/api/config/vitaqueen.php routes enquiries to:
#   ROLE_ALIASES="info sales export quality hr"
ROLE_ALIASES=

# Role mailboxes whose mail is expunged after RETENTION_DAYS by the monthly
# timer, so a mailbox does not quietly outlive the retention policy the
# application enforces on the same data. Space-separated local parts; empty
# disables the timer entirely.
RETENTION_MAILBOXES=
RETENTION_DAYS=365
