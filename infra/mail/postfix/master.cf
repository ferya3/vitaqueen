# ---------------------------------------------------------------------------
# Postfix master.cf — VitaQueen mail host
#
# Three listeners: MX on 25, implicit-TLS submission on 465, STARTTLS
# submission on 587. Cleartext IMAP/POP do not exist on this host at all.
# ---------------------------------------------------------------------------
#
# service      type  private unpriv  chroot  wakeup  maxproc  command + args
# ==========================================================================

# --- Inbound MX ------------------------------------------------------------
# No authentication offered here at all: a server that advertises AUTH on 25 is
# advertising a password-guessing target to every scanner on the internet.
smtp        inet  n       -       y       -       -       smtpd
    -o syslog_name=postfix/smtp-in

# --- Submission, implicit TLS (RFC 8314's preference) ----------------------
# The default for staff clients and for the application. TLS from the first
# byte: there is no cleartext phase to strip.
smtps       inet  n       -       y       -       -       smtpd
    -o syslog_name=postfix/smtps
    -o smtpd_tls_wrappermode=yes
    -o smtpd_sasl_auth_enable=yes
    -o smtpd_tls_security_level=encrypt
    -o smtpd_client_restrictions=permit_sasl_authenticated,reject
    -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
    -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject
    -o smtpd_sender_restrictions=reject_sender_login_mismatch,permit_sasl_authenticated,reject
    -o smtpd_helo_restrictions=
    -o smtpd_data_restrictions=
    -o cleanup_service_name=submission-cleanup
    -o milter_macro_daemon_name=ORIGINATING

# --- Submission, STARTTLS --------------------------------------------------
# Kept because some clients and libraries only know 587. Mandatory TLS: a
# client that will not upgrade does not get to authenticate.
submission  inet  n       -       y       -       -       smtpd
    -o syslog_name=postfix/submission
    -o smtpd_sasl_auth_enable=yes
    -o smtpd_tls_security_level=encrypt
    -o smtpd_client_restrictions=permit_sasl_authenticated,reject
    -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
    -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject
    -o smtpd_sender_restrictions=reject_sender_login_mismatch,permit_sasl_authenticated,reject
    -o smtpd_helo_restrictions=
    -o smtpd_data_restrictions=
    -o cleanup_service_name=submission-cleanup
    -o milter_macro_daemon_name=ORIGINATING

# Submitted mail passes through its own cleanup so the header_checks that strip
# the client's own Received header apply to submission only — never to inbound
# mail, where that chain is evidence.
submission-cleanup unix n -       y       -       0       cleanup
    -o syslog_name=postfix/submission-cleanup
    -o header_checks=pcre:/etc/postfix/submission_header_checks

pickup      unix  n       -       y       60      1       pickup
cleanup     unix  n       -       y       -       0       cleanup
qmgr        unix  n       -       n       300     1       qmgr
tlsmgr      unix  -       -       y       1000?   1       tlsmgr
rewrite     unix  -       -       y       -       -       trivial-rewrite
bounce      unix  -       -       y       -       0       bounce
defer       unix  -       -       y       -       0       bounce
trace       unix  -       -       y       -       0       bounce
verify      unix  -       -       y       -       1       verify
flush       unix  n       -       y       1000?   0       flush
proxymap    unix  -       -       n       -       -       proxymap
proxywrite  unix  -       -       n       -       1       proxymap
smtp        unix  -       -       y       -       -       smtp
relay       unix  -       -       y       -       -       smtp
showq       unix  n       -       y       -       -       showq
error       unix  -       -       y       -       -       error
retry       unix  -       -       y       -       -       error
discard     unix  -       -       y       -       -       discard
lmtp        unix  -       -       y       -       -       lmtp
anvil       unix  -       -       y       -       1       anvil
scache      unix  -       -       y       -       1       scache
postlog     unix-dgram n  -       n       -       1       postlogd
