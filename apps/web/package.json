{
  "name": "@vitaqueen/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "db:migrate": "node --disable-warning=ExperimentalWarning scripts/db.mjs migrate",
    "db:admin": "node --disable-warning=ExperimentalWarning scripts/db.mjs create-admin",
    "db:password": "node --disable-warning=ExperimentalWarning scripts/db.mjs reset-password",
    "db:reset-2fa": "node --disable-warning=ExperimentalWarning scripts/db.mjs reset-2fa",
    "db:prune": "node --disable-warning=ExperimentalWarning scripts/db.mjs prune",
    "db:backup": "node --disable-warning=ExperimentalWarning scripts/db.mjs backup"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-slot": "^1.4.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.1.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.55.0",
    "next": "16.3.2",
    "next-intl": "^4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "~5.9.3"
  }
}
