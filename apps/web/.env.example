# ---------------------------------------------------------------------------
# Frontend environment
#
# NEXT_PUBLIC_* values are inlined into the browser bundle. Anything secret
# belongs in the unprefixed variables below, which stay on the server.
# ---------------------------------------------------------------------------

# Canonical public origin. Drives canonical URLs, hreflang and Open Graph.
NEXT_PUBLIC_SITE_URL=https://vitaqueen.com

# Laravel API base, including the version prefix. Server-only on purpose: the
# browser never calls this, so it stays out of the client bundle.
API_URL=https://api.vitaqueen.com/api/v1

# "production" opens robots.txt. Anything else keeps the deployment closed to
# crawlers — a staging copy that gets indexed outranks the real site.
NEXT_PUBLIC_ENV=development

# Optional: host serving CMS media, added to the Next image allow-list.
# NEXT_PUBLIC_MEDIA_HOST=media.vitaqueen.com

# Fail the render instead of falling back to seeded sample content. Turn this
# on in production once the CMS is live, so a broken API is loud, not silent.
REQUIRE_API=false

# --- Server-only -----------------------------------------------------------

# Bearer token for the API, if the read endpoints are not public.
API_TOKEN=

# Cloudflare Turnstile. Site key is public, secret key must never be prefixed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
