# ---------------------------------------------------------------------------
# VitaQueen environment. Copy to `.env.local`; Next.js and `scripts/db.mjs`
# both read it.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time, so
# change them before `npm run build`. Everything else stays on the server.
# ---------------------------------------------------------------------------

# Canonical public origin. Drives canonical URLs, hreflang and Open Graph.
NEXT_PUBLIC_SITE_URL=https://vitaqueen.com

# "production" opens robots.txt. Anything else keeps the deployment closed to
# crawlers — a staging copy that gets indexed outranks the real site.
NEXT_PUBLIC_ENV=development

# --- Server-only -----------------------------------------------------------

# Encrypts TOTP secrets and recovery codes at rest. Required in production;
# generate with `openssl rand -hex 32`. Changing it invalidates every enrolled
# second factor (reset them with `npm run db:reset-2fa`).
APP_SECRET=

# Where the SQLite database and uploaded files live. Defaults to ./data.
# Keep it outside anything nginx serves, and back it up.
# DATA_DIR=/var/lib/vitaqueen

# Mark the admin session cookie `Secure` even when no proxy sends
# X-Forwarded-Proto. nginx and Cloudflare send it, so this is rarely needed.
# FORCE_SECURE_COOKIES=true

# Retention, in days. Audit rows are deleted after the first; contact-form IP
# addresses and user agents are stripped after the second.
# AUDIT_RETENTION_DAYS=730
# CONTACT_PII_RETENTION_DAYS=90

# Salt per 100 ml on the nutrition panel (identical for every format).
# SALT_PER_100ML=0.02 g

# Cloudflare Turnstile on the contact form. Optional; leave both empty to
# disable. The site key is public, the secret key must never be prefixed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
