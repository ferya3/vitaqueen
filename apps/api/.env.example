# ===========================================================================
# VitaQueen API
# ===========================================================================

APP_NAME=VitaQueen
APP_ENV=production
APP_KEY=
# APP_DEBUG must be false anywhere the internet can reach. The exception
# handler in bootstrap/app.php also refuses to leak traces, but that is the
# second lock, not the first.
APP_DEBUG=false
APP_URL=https://api.vitaqueen.com
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

# --- Database --------------------------------------------------------------
# MySQL must not listen on a public interface. Bind it to the private network
# or a socket, and give the application its own least-privileged user — never
# root. See docs/security.md.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vitaqueen
DB_USERNAME=vitaqueen_app
DB_PASSWORD=

# --- Cache, queue, session -------------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Hashing ---------------------------------------------------------------
# Argon2id. Tune on the production hardware: aim for 100–200 ms per hash.
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=2
ARGON_TIME=4

# --- Proxies ---------------------------------------------------------------
# Comma-separated list of the addresses nginx/Cloudflare connect from. Never
# "*": a wildcard lets anyone who reaches the origin forge X-Forwarded-For and
# walk past every per-IP rate limit.
TRUSTED_PROXIES=127.0.0.1

# Shared secret the Next.js renderer presents on its own read requests so it is
# not throttled by the public per-IP limiter. Generate with:
#   php -r 'echo bin2hex(random_bytes(32));'
INTERNAL_API_TOKEN=

# --- CORS ------------------------------------------------------------------
# Empty in production: Next.js calls this API server-to-server, so no browser
# origin needs access at all.
CORS_ALLOWED_ORIGINS=

# --- Admin -----------------------------------------------------------------
ADMIN_TOKEN_LIFETIME=480
AUDIT_RETENTION_DAYS=730
CONTACT_PII_RETENTION_DAYS=90

# First-run seeding only. Leave the password blank and the seeder generates one
# and prints it once.
ADMIN_SEED_EMAIL=admin@vitaqueen.com
ADMIN_SEED_NAME="VitaQueen Admin"
ADMIN_SEED_PASSWORD=

# --- Media -----------------------------------------------------------------
MEDIA_URL=https://media.vitaqueen.com
# SVG can carry script. Leave this off unless a scrubber is in front of it.
VITAQUEEN_ALLOW_SVG=false

# --- Mail ------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@vitaqueen.com
MAIL_FROM_NAME="${APP_NAME}"

MAIL_TO_GENERAL=info@vitaqueen.com
MAIL_TO_SALES=sales@vitaqueen.com
MAIL_TO_EXPORT=export@vitaqueen.com
MAIL_TO_QUALITY=quality@vitaqueen.com
MAIL_TO_CAREER=hr@vitaqueen.com

# --- Logging & monitoring --------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
SENTRY_LARAVEL_DSN=
